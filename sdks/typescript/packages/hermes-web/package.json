{
  "name": "@hermes-notifications/web",
  "version": "0.1.0",
  "description": "Embeddable inbox notification widget as a Web Component",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --environment jsdom"
  },
  "dependencies": {
    "@hermes-notifications/client": "workspace:*",
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "jsdom": "^30.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
