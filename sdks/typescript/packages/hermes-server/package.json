{
  "name": "@hermes-notifications/server",
  "version": "0.1.0",
  "description": "Hermes server SDK for sending notifications and managing the platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && rm -rf dist/generated && cp -r src/generated dist/generated",
    "clean": "rm -rf dist",
    "generate": "openapi-typescript ../../../../api/admin/openapi.yaml -o src/generated/admin-api.d.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.8"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  },
  "license": "Apache-2.0"
}
