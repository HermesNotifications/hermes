{
  // Emit config. Identical to tsconfig.json except that tests are left out of the
  // output: package.json publishes `files: ["dist"]`, so anything emitted here ships
  // to npm, and a stale dist/*.test.js is also collected as a second copy of the
  // suite. Tests are still type-checked — by `tsc --noEmit` against tsconfig.json.
  //
  // Both extensions are listed on purpose. A `.ts`-only pattern silently misses component
  // tests, which is not a hypothetical: adding the first `.test.tsx` file here made the suite
  // report 78 tests under `pnpm --filter` and 55 when run directly, because dist held a second
  // compiled copy.
  "extends": "./tsconfig.json",
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
