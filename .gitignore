# Binaries
/bin/
*.exe

# IDE / tools
.idea/
.vscode/
.claude/settings.local.json
.claude/state/
.claude/worktrees/
*.swp

# OS
.DS_Store

# Superpowers / Claude Code plugins
.superpowers/
.agents/
.mcp.json
skills-lock.json

# Worktrees
.worktrees/

# Environment
.env
.env.local

# Terraform
infra/terraform/.terraform/
*.tfstate
*.tfstate.backup
*.tfplan
# Built service binaries
/admin
/router
/worker-*
/inbox
/user
/migrate
/hermes
/loadseed
# SDKs - TypeScript
sdks/typescript/node_modules/
sdks/typescript/packages/*/dist/
sdks/typescript/packages/*/node_modules/

# SDKs - Java
sdks/java/hermes-server-sdk/target/
sdks/java/hermes-server-sdk/build/

# SDKs - .NET
sdks/dotnet/Hermes.ServerSdk/src/*/bin/
sdks/dotnet/Hermes.ServerSdk/src/*/obj/

# Helm chart dependencies (downloaded by helm dependency build)
charts/hermes/charts/

# Admin portal
web/admin/node_modules/
web/admin/.next/
web/admin/.env.local
# Incremental TypeScript build cache — committing it lets a stale cache mask
# type errors in CI (tsc --noEmit would skip "unchanged" files). Keep it local.
web/admin/*.tsbuildinfo

# pnpm workspace root
node_modules/
/seed
/dispatch

# load testing
/artifacts/
/loadtest/seed-manifest.json
/loadtest/dist/

# Kustomize helmCharts inflation (downloaded by `kustomize build --enable-helm`)
/deploy/observability/base/*/charts/

# Python bytecode — scripts/ holds the manifest checks run by `make verify-manifests`
__pycache__/
*.pyc

# The interpreter `make verify-manifests` provisions from scripts/requirements.txt. The gates
# need PyYAML and now fail rather than skip without it, so this is created on demand.
/.venv/
