{
  "annotations": {
    "list": []
  },
  "description": "Per-service overview for any Hermes Go service. Templated by the `service` variable.",
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "Request rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{service=\"$service\"}[5m]))",
          "legendFormat": "{{http_route}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Error rate (5xx)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{service=\"$service\",http_response_status_code=~\"5..\"}[5m]))",
          "legendFormat": "{{http_route}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Latency p50/p95/p99",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{service=\"$service\"}[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service=\"$service\"}[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{service=\"$service\"}[5m])))", "legendFormat": "p99", "refId": "C"}
      ]
    },
    {
      "title": "Go goroutines",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8},
      "targets": [
        {"expr": "go_goroutines{service=\"$service\"}", "legendFormat": "{{pod}}", "refId": "A"}
      ]
    },
    {
      "title": "Go heap in-use",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8},
      "targets": [
        {"expr": "go_memstats_heap_inuse_bytes{service=\"$service\"}", "legendFormat": "{{pod}}", "refId": "A"}
      ]
    },
    {
      "title": "Latency p95 by route",
      "description": "The service-wide p95 above hides which endpoint moved. Note the route label is the templated pattern, never the raw path.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "targets": [
        {"expr": "histogram_quantile(0.95,\n  sum by (http_route, le) (rate(http_server_request_duration_seconds_bucket{service=\"$service\"}[5m]))\n)", "legendFormat": "{{http_route}}", "refId": "A"}
      ]
    },
    {
      "title": "Authentication outcomes",
      "description": "Both gates, by reason. A wall of invalid_key after a deploy is a stale credential and looks like an outage to the caller while every health check stays green; the same series climbing against a flat ok rate is someone guessing.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {"expr": "sum by (scheme, reason) (rate(hermes_auth_result_total{service=\"$service\"}[5m]))", "legendFormat": "{{scheme}}: {{reason}}", "refId": "A"}
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["hermes", "service"],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(http_server_request_duration_seconds_count, service)",
        "refresh": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "title": "Hermes service — overview",
  "uid": "hermes-service-overview",
  "version": 2
}
