#!/usr/bin/env bash
# Copyright Hermes Notifications
# SPDX-License-Identifier: Apache-2.0
# See LICENSE in the project root for license terms and DISCLAIMER.md for important usage information.
#
# Generate a throwaway kustomize overlay that places the local overlay into a per-worker
# namespace and gives it its own ingress hostname.
#
# Why generated rather than checked in: kustomize has no variables, so a per-worker namespace
# cannot be expressed in a committed file without editing that file -- and a shared file edited
# per worker is exactly the contention this whole mechanism exists to remove. Two agents running
# `kustomize edit set namespace` against one overlay would race.
#
# Why a file tree rather than piping through sed: `namespace: hermes` appears both as a
# resource's own namespace and as an RBAC subject reference, and rewriting YAML with a regex
# gets one of those wrong eventually. Kustomize's namespace transformer handles both correctly,
# and it overrides the `namespace: hermes` that deploy/k8s/base sets -- which must stay, because
# staging relies on it (see the note in overlays/staging/kustomization.yaml).
#
# Usage: scripts/sandbox-overlay <worker> <namespace> <host>
# Prints the directory it generated.

set -euo pipefail

worker="${1:?usage: sandbox-overlay <worker> <namespace> <host>}"
namespace="${2:?missing namespace}"
host="${3:?missing host}"
tag="${4:-sandbox}"

# Kept in step with IMAGE_SERVICES in the Makefile.
services=(admin send dispatch worker-events worker-email worker-sms worker-inbox inbox user cleanup)

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
out="${repo_root}/.hermes/sandbox/${worker}"

mkdir -p "$out"

# A relative path, deliberately: kustomize rejects absolute paths in `resources`, which is the
# reason the devworker target avoided a generated overlay altogether. Relative works, so the
# generated tree has to live inside the repo -- .hermes/ is gitignored.
rel_to_local="$(python3 -c "import os,sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))" \
  "${repo_root}/deploy/k8s/overlays/local" "$out")"

cat >"${out}/kustomization.yaml" <<EOF
# GENERATED by scripts/sandbox-overlay -- do not edit, and do not commit.
# Regenerated on every \`make stack-up WORKER=${worker}\`.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

# Overrides the \`namespace: hermes\` that deploy/k8s/base sets. The transformer rewrites both
# resource namespaces and RBAC subject references, which is why this is not a text substitution.
namespace: ${namespace}

resources:
  - ${rel_to_local}

patches:
  # Bind both Ingresses to this sandbox's hostname. Without a host they are catch-all, and two
  # sandboxes would fight over the same routes on the one shared nginx -- last applied wins,
  # silently, and the loser's requests are answered by the winner's services.
  - path: ingress-host.yaml
    target:
      kind: Ingress
      name: hermes-ingress
  - path: realtime-host.yaml
    target:
      kind: Ingress
      name: hermes-realtime-ingress
  # Set the pull policy explicitly instead of letting it be inferred from the tag.
  #
  # Kubernetes defaults imagePullPolicy at admission -- Always for :latest, IfNotPresent
  # otherwise -- and then *persists* the result in the pod template. So a Deployment first
  # created with an untagged image keeps Always for the rest of its life, and later pointing it
  # at an imported :sandbox image does not change that: the kubelet still goes to Docker Hub,
  # finds no such public repository, and reports "pull access denied" for an image sitting in
  # its own content store. Being explicit makes the manifest say what it means and survives a
  # namespace that was created before this patch existed.
  #
  # The command is here for a related reason: deploy/docker/Dockerfile.dev bakes no ENTRYPOINT,
  # because under Tilt each service gets one from the restart wrapper. Without Tilt the
  # container starts alpine's default shell, which exits 0 immediately -- so the pod reports
  # CrashLoopBackOff with reason "Completed" and produces no logs at all, which is about the
  # least informative failure Kubernetes can give you. overlays/local already does exactly this
  # for the cleanup CronJob, for exactly this reason.
  - target:
      kind: Deployment
      name: "hermes-.*"
    patch: |
      - op: add
        path: /spec/template/spec/containers/0/imagePullPolicy
        value: IfNotPresent
      - op: add
        path: /spec/template/spec/containers/0/command
        value: ["/app/service"]

# Point every service at an image imported into the node's own content store, overriding the
# k3d-registry names overlays/local carries. Those names are a placeholder that only works
# under Tilt, which rewrites every image reference before applying; nothing else can pull them.
#
# The match key is the name as it stands *after* overlays/local has rewritten it, not the plain
# hermes-<svc> from base -- kustomize's image transformer matches on the current value, so
# matching the base name here silently does nothing and the pods sit in ImagePullBackOff.
# Keep the prefix in step with the images: block in overlays/local/kustomization.yaml.
images:
EOF

for svc in "${services[@]}"; do
  cat >>"${out}/kustomization.yaml" <<EOF
  - name: k3d-hermes-registry.localhost:5111/hermes-${svc}
    newName: hermes-${svc}
    newTag: ${tag}
EOF
done

# JSON6902 rather than a strategic merge: \`rules\` is a plain list with no merge key, so a
# strategic merge would replace the whole list and take every path rule with it.
cat >"${out}/ingress-host.yaml" <<EOF
# GENERATED by scripts/sandbox-overlay -- do not edit.
- op: add
  path: /spec/rules/0/host
  value: ${host}
EOF

cat >"${out}/realtime-host.yaml" <<EOF
# GENERATED by scripts/sandbox-overlay -- do not edit.
- op: add
  path: /spec/rules/0/host
  value: ${host}
EOF

echo "$out"
