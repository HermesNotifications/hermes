#!/usr/bin/env bash
# Copyright Hermes Notifications
# SPDX-License-Identifier: Apache-2.0
# See LICENSE in the project root for license terms and DISCLAIMER.md for important usage information.
#
# Write the per-worktree host ports that docker-compose.yml reads from .env.
#
# Docker Compose namespaces containers, networks and volumes by project name (the directory), but
# published host ports are global. Two worktrees running `make infra-up` therefore fight over
# 5432/6379/4222/8000, and the loser fails partway: some containers up, some not, and anything
# defaulting to localhost:5432 silently talking to the other worktree's database.
#
# The offset is derived from the worktree name rather than allocated, so it is stable across
# restarts and can be printed before anything starts. The main checkout keeps the historical
# ports, so nothing changes for someone not using worktrees.
#
# Usage:
#   scripts/compose-env          # write .env, print the exports
#   eval "$(scripts/compose-env)"  # ...and put them in your shell

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
worktree="$(basename "$root")"

if [ "$worktree" = "hermes" ]; then
  # The main checkout keeps the documented ports exactly, so every existing instruction and
  # every hardcoded localhost:5432 in someone's notes still works there.
  pg=5432; redis=6379; nats=4222; nats_mon=8222; smtp=1025; mailpit_ui=8025; dynamo=8000
else
  offset=$(printf '%s' "$worktree" | cksum | cut -d' ' -f1)
  offset=$(( offset % 100 ))

  # Each service gets its own disjoint block of 100 in the 15400-16099 range, rather than
  # "historical port + offset".
  #
  # Two reasons. Adding an offset to the real ports lands on things that matter -- 8000 + 80 is
  # 8080, which is this project's own admin service, and 8025 + offset walks through the whole
  # 8080-8088 service range. And blocks that overlap each other let two *different* worktrees
  # collide on the same number from different services, which is the most confusing possible
  # version of this bug: Postgres answering on what something thinks is Redis.
  #
  # Disjoint blocks make both impossible by construction.
  pg=$(( 15400 + offset ))
  redis=$(( 15500 + offset ))
  nats=$(( 15600 + offset ))
  nats_mon=$(( 15700 + offset ))
  smtp=$(( 15800 + offset ))
  mailpit_ui=$(( 15900 + offset ))
  dynamo=$(( 16000 + offset ))
fi

# Compose reads .env from the project directory automatically, which is the only way to get
# these into the port mappings without a wrapper around every `docker compose` invocation.
cat >"${root}/.env" <<EOF
# GENERATED by scripts/compose-env for worktree '${worktree}' -- do not commit.
# Regenerated by \`make infra-up\`.
HERMES_PG_PORT=${pg}
HERMES_REDIS_PORT=${redis}
HERMES_NATS_PORT=${nats}
HERMES_NATS_MONITOR_PORT=${nats_mon}
HERMES_SMTP_PORT=${smtp}
HERMES_MAILPIT_UI_PORT=${mailpit_ui}
HERMES_DYNAMO_PORT=${dynamo}
EOF

# Printed as exports so the test suite and `make migrate` follow the same ports the containers
# actually published. Without this the offset would move the containers and leave every client
# still pointed at 5432.
echo "export HERMES_DATABASE_URL='postgres://hermes:hermes@localhost:${pg}/hermes?sslmode=disable'"
echo "export HERMES_REDIS_URL='redis://localhost:${redis}'"
echo "export HERMES_NATS_URL='nats://localhost:${nats}'"
echo "export HERMES_DYNAMO_ENDPOINT='http://localhost:${dynamo}'"
echo "export HERMES_EMAIL_SMTP_HOST=localhost"
# The port matters as much as the host, and its absence here was worse than a missing
# variable: the Mailpit tests fell back to 1025, which in a worktree is not this stack's
# Mailpit but the *main checkout's*. The send was accepted by the wrong container while the
# assertion queried MAILPIT_API_URL, which was correctly offset -- so both Mailpit tests
# failed in every worktree, and did so by cross-talking into another checkout's stack
# rather than by failing to connect.
echo "export HERMES_EMAIL_SMTP_PORT=${smtp}"
echo "export MAILPIT_API_URL='http://localhost:${mailpit_ui}'"
