#!/usr/bin/env bash
# Copyright Hermes Notifications
# SPDX-License-Identifier: Apache-2.0
# See LICENSE in the project root for license terms and DISCLAIMER.md for important usage information.
#
# Run migrations, NATS stream provisioning and the dev API key seed against a sandbox namespace.
#
# These three exist as in-cluster Jobs in deploy/k8s/base, but overlays/local deletes them
# because Tilt runs the same binaries as local_resources against its port-forwards. A sandbox
# does not run Tilt, so something still has to do their work -- this is that something.
#
# ## Why port-forwards and not ClusterIPs
#
# devworker-env hands out ClusterIPs and docs/development.md says the host can route to them.
# That is true when the host *is* the k3s node, i.e. k3s on Linux. It is false under k3d, where
# k3s runs inside a Docker container: the service CIDR lives in the container's network
# namespace and the host has no route to it. Connections do not refuse, they hang until they
# time out, which reads as "Postgres is broken" rather than "you cannot get there from here".
#
# An ephemeral forward on port 0 works on both, contends with nothing (the kernel picks a free
# port), and lives only as long as this script.

set -euo pipefail

ns="${1:?usage: sandbox-bootstrap <namespace> [context]}"

# Pinned rather than ambient, for the same reason the Makefile pins it: the current context is
# global state that anything on the machine can change, including between two commands of one
# run. Defaulting to the local k3d cluster keeps this script honest when invoked by hand.
context="${2:-k3d-hermes-dev}"
kubectl() { command kubectl --context "$context" "$@"; }

pids=()
cleanup() {
  for pid in "${pids[@]:-}"; do
    [[ -n "$pid" ]] && kill "$pid" 2>/dev/null || true
  done
}
trap cleanup EXIT

# Start a background port-forward and echo the host port the kernel chose.
#
# `:PORT` asks kubectl for a random local port; it announces the choice on stdout as
# "Forwarding from 127.0.0.1:54321 -> 5432", which is the only way to learn it.
forward() {
  local target="$1" port="$2" log
  log="$(mktemp)"
  kubectl -n "$ns" port-forward "$target" ":${port}" >"$log" 2>&1 &
  pids+=("$!")

  for _ in $(seq 1 50); do
    local chosen
    chosen="$(sed -n 's/.*127\.0\.0\.1:\([0-9]*\) ->.*/\1/p' "$log" | head -1)"
    if [[ -n "$chosen" ]]; then
      echo "$chosen"
      return 0
    fi
    sleep 0.2
  done

  echo "port-forward to ${target} in ${ns} never reported a local port:" >&2
  cat "$log" >&2
  return 1
}

pg_port="$(forward svc/postgres 5432)"
# NATS is a headless Service with no ClusterIP, so the forward targets the pod directly.
nats_port="$(forward pod/nats-0 4222)"

db="postgres://hermes:hermes@localhost:${pg_port}/hermes?sslmode=disable"

echo "migrating ${ns}..."
go run ./cmd/migrate/ -database-url "$db" -migrations-path ./migrations

echo "provisioning NATS streams..."
# Plaintext with no accounts: overlays/local/patches/nats-local.yaml replaces the server args, so
# nats.conf and its accounts block are never read and there is nobody to authenticate as.
HERMES_NATS_URL="nats://localhost:${nats_port}" \
  HERMES_NATS_CA_BUNDLE= \
  HERMES_NATS_NKEY_SEED= \
  go run ./cmd/natsprovision/

echo "seeding dev API key..."
go run ./cmd/seed/ -database-url "$db"
