# Origin of the Hermes ingress.
#
# NOTE: `make seed` writes HERMES_API_URL=http://localhost:8080 into web/admin/.env.local.
# That is the admin service's port-forward, and it does NOT serve /v1/send — that route
# belongs to hermes-send. Use the ingress on :8888, which routes every path. `make dev-demo`
# takes the *key* from that file and the URL from here.
HERMES_API_URL=http://localhost:8888

# A server-to-server API key with the `organizations:manage` permission, needed to mint user
# tokens. Generate one with `make seed`; it is written to web/admin/.env.local.
#
# This key must never reach the browser. It stays in this process, which is the entire reason
# the demo has a backend at all.
HERMES_API_KEY=

# Where the browser opens its websocket. Cross-origin on purpose: websockets are not subject
# to CORS, so the browser talks to Centrifugo directly rather than through the /v1 proxy, and
# that is how a real deployment looks.
HERMES_SOCKET_URL=http://localhost:8888/realtime

# Signs the demo's stand-in session cookie. Any random string; the cookie carries no secret,
# the signature only stops a visitor editing the organization id in devtools.
DEMO_COOKIE_SECRET=change-me

PORT=8899
